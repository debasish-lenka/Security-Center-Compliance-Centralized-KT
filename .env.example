# Copy to .env on the server (cp .env.example .env) and fill in. Never commit .env.
# Generate secrets with: openssl rand -hex 16   (32 chars; use twice for 64)

POSTGRES_PASSWORD=change-me
JWT_SECRET=change-me-to-64-hex-chars
SESSION_SECRET=change-me-to-64-hex-chars
ENCRYPTION_KEY=exactly-32-characters-here-12345

# Port opened on the Ubuntu host (pick one that is free: sudo ss -tlnp)
WEB_PORT=8081
# How users open the dashboard
CORS_ORIGIN=http://<UBUNTU_IP>:8081
# true only if you later add HTTPS
COOKIE_SECURE=false
# Password for the first admin created by the seed step
SEED_ADMIN_PASSWORD=change-me-too
